#!/usr/bin/env bash
#
# pre-commit: regenerate README.md from readme.org when readme.org is staged.
#
# Uses Emacs in batch mode (see export-readme.el). The regenerated README.md
# is added to the commit automatically. If readme.org is not part of the
# commit, this hook does nothing.

set -euo pipefail

# Only act when readme.org is part of this commit.
if ! git diff --cached --name-only | grep -qx 'readme.org'; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
src="$repo_root/readme.org"
out="$repo_root/README.md"
elisp="$repo_root/.githooks/export-readme.el"

if ! command -v emacs >/dev/null 2>&1; then
  echo "pre-commit: emacs not found; cannot regenerate README.md" >&2
  exit 1
fi

emacs --batch --no-init-file --load "$elisp" \
  --eval "(my/export-readme \"$src\")" >/dev/null 2>&1

git add "$out"
